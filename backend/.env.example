# Copy to backend/.env and fill in. Unset providers degrade gracefully (see GET /api/health).

# --- Language services (ASR, translation, TTS, OCR) -------------------------------
# IIIT Bhashini sandbox (https://canvas.iiit.ac.in). Auth: paste an access token, or
# give your sandbox email + password so the backend logs in (and again on expiry).
LANGUAGE_PROVIDER=canvas
CANVAS_ACCESS_TOKEN=
CANVAS_EMAIL=
CANVAS_PASSWORD=

# Model IDs = the last part of each service URL, e.g.
#   .../sandboxbeprod/check_model_status_and_infer/<MODEL_ID>
# One per language / language pair. Empty = that service is unavailable:
# no NMT for a pair -> answers come back in English; no ASR -> type or use the phrase board.
CANVAS_ASR_EN_MODEL=
CANVAS_ASR_HI_MODEL=
CANVAS_ASR_TE_MODEL=
CANVAS_NMT_HI_EN_MODEL=
CANVAS_NMT_EN_HI_MODEL=
CANVAS_NMT_TE_EN_MODEL=
CANVAS_NMT_EN_TE_MODEL=
CANVAS_TTS_EN_MODEL=
CANVAS_TTS_HI_MODEL=
CANVAS_TTS_TE_MODEL=
CANVAS_OCR_MODEL=

# Alternative: public Bhashini ULCA account (LANGUAGE_PROVIDER=ulca).
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=

# --- Vision model: pick ONE provider ----------------------------------------------
# Open model via any OpenAI-compatible server (Ollama, vLLM, Groq, Together, OpenRouter).
VISION_PROVIDER=openai_compat
#   Local Ollama (fits a 6 GB GPU):
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5vl:7b
OPENAI_API_KEY=
#   Hosted Llama 4 on Groq instead:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# OPENAI_API_KEY=gsk_...

# Or Claude:
# VISION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_EFFORT=low

# Timeouts. Claude needs ~18/25 s; a local 7B model on a laptop GPU needs more
# (measured 12-25 s per answer for qwen2.5vl:7b on an RTX 3060 6 GB).
VISION_TIMEOUT_S=40
REQUEST_DEADLINE_S=55

# --- Optional: dedicated OCR. Without it, OCR is a transcription pass on the vision model.
GOOGLE_VISION_API_KEY=
